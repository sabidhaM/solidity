pragma solidity ^0.8.20;

contract MultiTransaction {

    receive() external payable { }

    function multiTransfer(address[] memory to, uint256[] memory amount) public payable {
        require(to.length == amount.length,"length mismatch");

        uint256 totalAmount;

        for(uint256 i=0; i< amount.length; i++) {
            totalAmount += amount[i];
        }

        require(msg.value == totalAmount, "Incorrect ETH");
        
        for(uint256 i=0; i< to.length; i++) {
          (bool success, ) = payable(to[i]).call{
                value: amount[i]
            }("");

            require(success, "Transfer failed");
        }
    }

} 
